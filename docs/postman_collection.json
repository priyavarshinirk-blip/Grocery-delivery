        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/products"
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        }
      ]
    },
    {
      "name": "4. Store Stock",
      "item": [
        {
          "name": "Upsert Stock - Happy Path",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/store-stock",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"{{storeId}}\",\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 3,\n  \"reorderPoint\": 10\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('stockId', pm.response.json().data.stock._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Low Stock Alerts (Module 9)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/store-stock/low-stock?storeId={{storeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contains the just-created low-stock product', () => pm.expect(pm.response.json().data.count).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "Adjust Stock - Insufficient Stock Conflict",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/store-stock/{{stockId}}/adjust",
            "body": { "mode": "raw", "raw": "{\n  \"delta\": -1000\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('errorCode is INSUFFICIENT_STOCK', () => pm.expect(pm.response.json().errorCode).to.eql('INSUFFICIENT_STOCK'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Stock By Store",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/store-stock/store/{{storeId}}"
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        }
      ]
    },
    {
      "name": "5. Orders - Placement & Workflow",
      "item": [
        {
          "name": "Place Order - Business Rule Conflict (Out of Stock)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [ { \"productId\": \"{{productId}}\", \"quantity\": 999 } ],\n  \"deliveryAddress\": { \"line1\": \"HSR Layout\", \"area\": \"HSR\", \"pincode\": \"560102\" }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('errorCode is INSUFFICIENT_STOCK', () => pm.expect(pm.response.json().errorCode).to.eql('INSUFFICIENT_STOCK'));"
                ]
              }
            }
