{
  "info": {
    "name": "P19 - Online Grocery Delivery Platform",
    "description": "Full API collection for the Quick Commerce grocery delivery backend. Run folders top-to-bottom (Auth first) - later requests depend on tokens/ids captured by earlier ones via collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "adminToken", "value": "" },
    { "key": "staffToken", "value": "" },
    { "key": "customerToken", "value": "" },
    { "key": "deliveryToken", "value": "" },
    { "key": "storeId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "stockId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "deliveryPartnerId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register Customer (first-time bootstrap via direct DB seed recommended)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"email\": \"customer1@grocery.test\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\",\n  \"phone\": \"9876543210\",\n  \"defaultAddress\": { \"line1\": \"12 MG Road\", \"area\": \"Koramangala\", \"pincode\": \"560034\" }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Response has token', () => pm.expect(json.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('customerToken', json.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Validation Failure (missing fields)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"not-an-email\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('errorCode is VALIDATION_ERROR', () => pm.expect(pm.response.json().errorCode).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - Duplicate Email Conflict",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Priya Sharma\",\n  \"email\": \"customer1@grocery.test\",\n  \"password\": \"Password123!\",\n  \"role\": \"customer\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('errorCode is DUPLICATE_KEY', () => pm.expect(pm.response.json().errorCode).to.eql('DUPLICATE_KEY'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Store Staff (seeded)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"staff.koramangala@grocery.test\",\n  \"password\": \"Password123!\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('staffToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Admin (seeded)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@grocery.test\",\n  \"password\": \"Password123!\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Delivery Partner (seeded)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"delivery@grocery.test\",\n  \"password\": \"Password123!\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('deliveryToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Wrong Password (Auth Failure)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@grocery.test\",\n  \"password\": \"wrong-password\"\n}" }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] }
            }
          ]
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Update Current User Profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/auth/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Customer\",\n  \"email\": \"updated-customer@grocery.test\",\n  \"phone\": \"9876543210\",\n  \"defaultAddress\": {\n    \"line1\": \"12 MG Road\",\n    \"area\": \"Koramangala\",\n    \"pincode\": \"560034\"\n  }\n}"
            }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Get Current User - No Token (Auth Failure)",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 401', () => pm.response.to.have.status(401));"] } }
          ]
        }
      ]
    },
    {
      "name": "2. Dark Stores (Admin)",
      "item": [
        {
          "name": "Create Dark Store - Happy Path",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/dark-stores",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"HSR Layout Dark Store\",\n  \"area\": \"HSR Layout, Bengaluru\",\n  \"location\": { \"coordinates\": [77.6387, 12.9121] },\n  \"serviceablePincodes\": [\"560102\"]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('storeId', pm.response.json().data.store._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Dark Store - Wrong Role (Authorization Failure)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "url": "{{baseUrl}}/dark-stores",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Should Fail\",\n  \"area\": \"X\",\n  \"location\": { \"coordinates\": [0,0] }\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 403', () => pm.response.to.have.status(403));"] } }
          ]
        },
        {
          "name": "List Dark Stores",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/dark-stores"
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        },
        {
          "name": "Get Dark Store - Not Found",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/dark-stores/000000000000000000000000"
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 404', () => pm.response.to.have.status(404));"] } }
          ]
        },
        {
          "name": "Update Dark Store",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/dark-stores/{{storeId}}",
            "body": { "mode": "raw", "raw": "{\n  \"serviceablePincodes\": [\"560102\", \"560068\"]\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 200', () => pm.response.to.have.status(200));"] } }
          ]
        }
      ]
    },
    {
      "name": "3. Products (Admin)",
      "item": [
        {
          "name": "Create Product - Happy Path",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": "{{baseUrl}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Organic Tomatoes\",\n  \"category\": \"Fruits & Vegetables\",\n  \"price\": 35,\n  \"unit\": \"kg\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('productId', pm.response.json().data.product._id);"
                ]
              }
            }
          ]
        },
        {
