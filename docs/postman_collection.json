            "url": "{{baseUrl}}/products",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bad Product\",\n  \"category\": \"Misc\",\n  \"price\": -5\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": ["pm.test('Status is 400', () => pm.response.to.have.status(400));"] } }
          ]
