            "url": "{{baseUrl}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [ { \"productId\": \"{{productId}}\", \"quantity\": 1 } ],\n  \"deliveryAddress\": { \"line1\": \"HSR Layout\", \"area\": \"HSR\", \"pincode\": \"560102\" },\n  \"deliverySlot\": { \"date\": \"2026-09-10\", \"startTime\": \"10:00\", \"endTime\": \"12:00\" }\n}"
